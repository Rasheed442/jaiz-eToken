{
  "expo": {
    "name": "Jaiz eToken",
    "slug": "jaiz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jaiz",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs camera access to verify your identity for secure transactions.",
        "NSMicrophoneUsageDescription": "MetaMap may use the microphone during identity verification.",
        "NSPhotoLibraryUsageDescription": "MetaMap may use your photo library when an identity verification step requires it.",
        "NSLocationWhenInUseUsageDescription": "MetaMap may use your location during identity verification.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "MetaMap may use your location during identity verification.",
        "NSLocationAlwaysUsageDescription": "MetaMap may use your location during identity verification.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.rasheed44.jaiz"
    },
    "android": {
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "pan",
      "icon": "./assets/images/jaiz-favicon-logo.jpeg",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/jaiz-favicon-logo.jpeg"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.rasheed44.jaiz"
    },
    "web": {
      "output": "static",
      "bundler": "metro",
      "favicon": "./assets/images/jaiz-favicon-logo.jpeg",
      "name": "Jaiz eToken"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-asset",
      "@react-native-community/datetimepicker",
      "expo-image",
      "expo-web-browser",
      "react-native-metamap-sdk/plugin/build",
      "./plugins/withMetaMapAndroidSdkPin"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "07db28b4-9f49-482e-9c00-17eac4dc501e"
      }
    },
    "owner": "ralphadigital"
  }
}
